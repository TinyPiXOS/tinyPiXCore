# 安装bin文件
set(TPWM_INSTALL_BIN_DIR "/usr/bin")
# 安装依赖动态库
set(TPWM_INSTALL_DEPEND_SO_DIR "/usr/lib/TpWM")

# 安装头文件目录
set(TPWM_INSTALL_INCLUDE_DIR "/usr/include/TpWM")

# 安装系统底层依赖
set(TPWM_INSTALL_SYSTEM_DIR "/System")
set(TPWM_INSTALL_SYSTEM_PLUGIN "${INSTALL_SYSTEM_DIR}/plugin")
set(TPWM_INSTALL_SYSTEM_RUN "${INSTALL_SYSTEM_DIR}/run")
set(TPWM_INSTALL_SYSTEM_CONF "${INSTALL_SYSTEM_DIR}/conf")
set(TPWM_INSTALL_SYSTEM_DATA "${INSTALL_SYSTEM_DIR}/data")

# 定义动态库软链接的目标目录
set(TPWM_LINK_LIB_DIR "/usr/lib")
